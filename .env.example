# ==========================================
# Techno Stationery Dashboard - Environment Configuration
# ==========================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control!

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=YourNewStrongPassword

# Database Names
DB_PROD=technadminy7_dBT8x12y22
DB_BETA=beta_dBT8x12y22

# Site Paths
PROD_PATH=/home/technadminy7/public_html
BETA_PATH=/home/beta/public_html
PIM_PATH=/home/pim/public_html
DASHBOARD_PATH=/home/dashboard/public_html
DEV_PATH=/home/dev/public_html
LMS_PATH=/home/lms/public_html

# PHP Configuration
PHP_BIN=/opt/cpanel/ea-php82/root/usr/bin/php

# Telegram Bot Configuration
TELEGRAM_SERVER_BOT_TOKEN=your_server_bot_token_here
TELEGRAM_CUSTOMER_BOT_TOKEN=your_customer_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Cloudflare API Configuration
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ZONE_ID=your_cloudflare_zone_id_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_EMAIL=your_email_here

# AI/QoderCLI Configuration
QODERCLI_PATH=/root/.qoder/bin/qodercli/qodercli-0.2.2

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=https://dashboard.technostationery.com

# Session Configuration
SESSION_LIFETIME=3600
SESSION_SECURE=true

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Alert Configuration
ALERTS_ENABLED=true
ALERT_DEDUP_WINDOW=1800

# Scripts Configuration
SCRIPTS_DIR=/home/dashboard/public_html/scripts
LOGS_DIR=/home/dashboard/public_html/scripts
