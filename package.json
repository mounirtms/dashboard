{
  "name": "technostationery-magento2",
  "version": "1.0.0",
  "description": "TechnoStationery Magento 2 Optimization Scripts",
  "scripts": {
    "optimize:all": "bash scripts/run_all_optimizations.sh",
    "optimize:amasty": "bash optimize_amasty_modules.sh",
    "optimize:images": "php fix_images_and_attributes.php",
    "optimize:cpu": "bash optimize_cpu_and_images.sh",
    "optimize:database": "bash database_cleanup.sh",
    "optimize:attributes": "php audit_and_fix_attribute_set_23.php",
    "analyze:blocks": "bash analyze_html_blocks.sh",
    "analyze:catalog": "php deep_catalog_audit.php",
    "verify:all": "bash verify_optimizations.sh",
    "indexer:status": "php bin/magento indexer:status",
    "indexer:reindex:amasty": "php bin/magento indexer:reindex $(php bin/magento indexer:status | grep -i amasty | awk '{print $1}' | tr '\\n' ' ')",
    "indexer:reindex:all": "php bin/magento indexer:reindex",
    "cache:flush": "php bin/magento cache:flush",
    "cache:clean": "php bin/magento cache:clean",
    "maintenance:enable": "php bin/magento maintenance:enable",
    "maintenance:disable": "php bin/magento maintenance:disable",
    "deploy:production": "php bin/magento setup:static-content:deploy -f en_US fr_FR",
    "deploy:upgrade": "php bin/magento setup:upgrade && php bin/magento setup:di:compile"
  },
  "keywords": [
    "magento2",
    "optimization",
    "performance",
    "amasty",
    "technostationery"
  ],
  "author": "TechnoStationery Team",
  "license": "PROPRIETARY",
  "devDependencies": {},
  "dependencies": {}
}
