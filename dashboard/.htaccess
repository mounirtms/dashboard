# Dashboard source directory — NOT for serving in production
# Build output goes to /public_html/build/ via post-build.sh

# Block access to source files and node_modules
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order Deny,Allow
  Deny from all
</IfModule>
