# Presentation directory — auth-gated via PHP

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve index.php for directory requests
  DirectoryIndex index.php

  # Rewrite index.html → index.php (internal, no 301 to avoid browser cache)
  RewriteRule ^index\.html$ /presentation/index.php [L]
</IfModule>

# Block direct access to backup files
<FilesMatch "\.(bak|backup|old|orig)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set Cache-Control "no-store, no-cache, must-revalidate, private, max-age=0"
  Header set Pragma "no-cache"
</IfModule>
