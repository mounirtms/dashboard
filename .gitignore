# Magento 2 specific files and directories to ignore

# Magento generated files
 
/var/
/pub/static/
/generated/
/pub/pma/
/pub/media/amasty/
/pub/media/sm/

# Composer dependencies
/vendor/

# Node modules
/node_modules/

# IDE files
/.idea/
/.vscode/
/nbproject/

# OS generated files
.DS_Store
Thumbs.db

# Log files
*.log

# Backup files
*.bak
*.swp
*.backup
*.old

# Large files that shouldn't be tracked
rsync_log.txt
*.har
composer.lock

# Session files
pub/media/customer_address/*/*/sess_*
pub/media/customer/*/*/sess_*

# Media files (except .htaccess)
/pub/media/*
!/pub/media/.htaccess

# Static files
/pub/static/*
!/pub/static/.htaccess

# Var directory
/var/*
!/var/.htaccess

# Vendor directory
/vendor/*
!/vendor/.htaccess

# Generated directory
/generated/*
!/generated/.htaccess

# Other common files to ignore
error_log
*.tmp
*.temp
*.cache
.svn
.git