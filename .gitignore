# ==========================================
# Techno Stationery Dashboard - .gitignore
# ==========================================

# Dependencies
node_modules/
package-lock.json

# Build outputs
dist/
dist_prod/
dist_complete/
webapp_public/
app/

# Environment & Sensitive Config
.env
.env.local
.env.*.local
!.env.example
config/private/
*.key
*.pem

# Logs & Runtime
logs/
*.log
error_log
api/error_log
api/telegram/logs/

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:stream

# Backup Files
*.bak
*.backup
*.old
*.tmp
*.temp
index.html.static.bak
login.html.bak

# Generated Files
assets/*.js
assets/*.css
assets/*.map
cache-buster.js
version.json

# Qoder & AI
.qwen/
.qoder/

# Git Credentials
.git-credentials

# Testing
coverage/
.nyc_output/

# Symlinks
phpmyadmin/

# Data directories (contain runtime data)
api/telegram/data/
