<?php
/**
 * Dashboard Authentication Handler
 * Handles login, logout, session management, and API authentication
 */
session_start();

// Load environment variables
$envFile = dirname(__DIR__) . '/.env';
if (file_exists($envFile)) {
    $lines = file($envFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($lines as $line) {
        if (strpos(trim($line), '#') === 0) continue;
        if (strpos($line, '=') !== false) {
            list($key, $value) = explode('=', $line, 2);
            $_ENV[trim($key)] = trim($value);
        }
    }
}

// If we don't have a logged in user in the session, try to load from our custom session table
if (empty($_SESSION['logged_in']) && isset($_COOKIE[session_name()])) {
    $sessionId = $_COOKIE[session_name()];
    $pdo = getDb();
    // Check if the session exists and is not expired (24 hours)
    $stmt = $pdo->prepare("SELECT user_id FROM sessions WHERE id = ? AND last_activity > ?");
    $stmt->execute([$sessionId, time() - 86400]);
    $session = $stmt->fetch();
    if ($session) {
        // Get user details
        $userStmt = $pdo->prepare("SELECT username, full_name, role FROM users WHERE id = ? AND is_active = 1");
        $userStmt->execute([$session['user_id']]);
        $user = $userStmt->fetch();
        if ($user) {
            $_SESSION['user_id'] = $session['user_id'];
            $_SESSION['username'] = $user['username'];
            $_SESSION['full_name'] = $user['full_name'];
            $_SESSION['role'] = $user['role'];
            $_SESSION['logged_in'] = true;
            // Update last activity
            $pdo->prepare("UPDATE sessions SET last_activity = ? WHERE id = ?")->execute([time(), $sessionId]);
        }
    }
}

/**
 * Authentication check class
 */
