[mysqld]
# Basic Settings
port = 3307
socket = /opt/mariadb10.6/mariadb.sock
datadir = /opt/mariadb10.6/data
pid-file = /opt/mariadb10.6/mariadb.pid
log-error = /opt/mariadb10.6/mariadb-error.log
basedir = /opt/mariadb10.6/mariadb

# Connection & Thread Settings (STABILITY OPTIMIZED)
max_connections = 200
max_user_connections = 150
thread_cache_size = 100
table_open_cache = 4096
table_definition_cache = 2048

# Memory Settings (Balanced for 32GB RAM)
innodb_buffer_pool_size = 6G
innodb_log_file_size = 512M
innodb_log_buffer_size = 64M
key_buffer_size = 256M
query_cache_size = 0
query_cache_type = 0
tmp_table_size = 128M
max_heap_table_size = 128M
sort_buffer_size = 2M
read_buffer_size = 1M
read_rnd_buffer_size = 2M
join_buffer_size = 2M

# InnoDB Settings (STABILITY OPTIMIZED)
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1
innodb_buffer_pool_instances = 6
innodb_read_io_threads = 4
innodb_write_io_threads = 4
innodb_io_capacity = 1000
innodb_io_capacity_max = 2000
innodb_lru_scan_depth = 1024

# Connection Stability Settings
connect_timeout = 30
wait_timeout = 300
interactive_timeout = 300
net_read_timeout = 30
net_write_timeout = 60

# Slow Query Log (Enabled for debugging)
slow_query_log = 1
long_query_time = 2
slow_query_log_file = /opt/mariadb10.6/slow.log

# Binary Log (Disabled for performance)
skip-log-bin

# Character Set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Open Files Limit
open_files_limit = 40000

[client]
port = 3307
socket = /opt/mariadb10.6/mariadb.sock

[mysql]
default-character-set = utf8mb4