            "text": "{\"ok\":true,\"data\":{\"settingsVersion\":\"2-37-0\",\"propertyName\":\"TechnoStationery\",\"branding\":{\"whitelabeled\":false,\"text\":\":tawky: Add free *live chat* to your site\",\"url\":\"https://www.tawk.to/?utm_source=tawk-messenger&utm_medium=link&utm_campaign=referral&utm_term=5f7eb8f54704467e89f5a395\"},\"widget\":{\"type\":\"inline\",\"version\":31,\"agentDrivenStatus\":false,\"language\":\"ar\",\"minimized\":{\"desktop\":{\"type\":\"round\"},\"mobile\":{\"type\":\"round\"}},\"maximized\":{\"desktop\":{\"height\":520,\"width\":350}},\"theme\":{\"header\":{\"background\":\"#03a84e\",\"text\":\"#ffffff\"},\"agent\":{\"messageBackground\":\"#03a84e\",\"messageText\":\"#ffffff\"},\"visitor\":{\"messageBackground\":\"#e5e5e5\",\"messageText\":\"#333333\"}},\"notification\":{\"all\":{\"estimatedWaitTime\":false,\"sound\":true,\"agentTyping\":true,\"visitorTyping\":true,\"tab\":true},\"desktop\":{\"preview\":true},\"mobile\":{\"preview\":true}},\"behavior\":{\"click\":\"max\"},\"visibility\":{\"all\":{\"showWhenOffline\":true},\"desktop\":{\"position\":\"br\",\"show\":true},\"mobile\":{\"position\":\"cr\",\"show\":true}},\"features\":{\"emoji\":true,\"uploads\":true,\"rating\":true,\"transcript\":true},\"components\":{\"liveChat\":true,\"kb\":true,\"webrtc\":true},\"scheduler\":{\"enabled\":false,\"config\":{\"timezone\":\"Africa/Algiers\",\"schedule\":[{\"day\":0,\"start\":0,\"end\":1440},{\"day\":1,\"start\":0,\"end\":1440},{\"day\":2,\"start\":0,\"end\":1440},{\"day\":3,\"start\":0,\"end\":1440},{\"day\":4,\"start\":0,\"end\":1440},{\"day\":5,\"start\":0,\"end\":1440},{\"day\":6,\"start\":0,\"end\":1440}]}},\"states\":{\"online\":{\"header\":[{\"id\":\"text:1FKD15mJEt\",\"type\":\"text\",\"content\":{\"value\":\"نحن متصلون وعلى إستعداد لخدمتك الآن. إبدأ بالكتابة لبدء محادثة مباشرة.\",\"alignment\":\"center\"}}],\"body\":[{\"id\":\"chat:MQPIDz3Alb\",\"type\":\"chat\",\"content\":{\"buttonText\":\"محادثة جديدة\",\"inputPlaceholder\":\"أكتب