          "content": {
            "size": 16489,
            "mimeType": "application/json",
            "text": "{\n    \"bubble\": {\n        \"attention_grabber\": \"الدردشة الملفتة للإنتباه\"\n    },\n    \"chat\": {\n        \"accept_call\": \"قبول\",\n        \"active\": \"نشط\",\n        \"agent_profile_image\": \"صورة الملف الشخصي للوكيل\",\n        \"agent_ringing\": \"مكالمة واردة\",\n        \"all_conversations\": \"شاهد جميع المحادثات.\",\n        \"call_end_details\": \"بدأت في {{ startedOn }} واستمرت حتى {{ duration }}\",\n        \"call_error_load\": \"تعذر تحميل تفاصيل المكالمة.\",\n        \"call_started_on\": \"بدأت في {{ startedOn }}\",\n        \"chat_ended\": \"انتهت المحادثة\",\n        \"chat_icon\": \"أيقونة الدردشة\",\n        \"chat_qm\": \"دردشة؟\",\n        \"chat_text\": \"محادثة\",\n        \"close_icon\": \"أغلق الأيقونة\",\n        \"completed_call\": \"انتهت المكالمة\",\n        \"conversation_ended_on\": \"انتهت المحادثة في \",\n        \"decline_call\": \"رفض\",\n        \"default_name\": \"أنت (أنقر هنا لتغيير الاسم)\",\n        \"department_is_away\": \"قسم {{ strongStart }} {{ departmentName }} {{ strongEnd }} بعيد حاليا.\",\n        \"department_is_offline\": \"قسم {{ strongStart }} {{ departmentName }} {{ strongEnd }} غير متصل حالياً. سيتم تحويلك إلى قسم آخر.\",\n        \"download\": \"تنزيل\",\n        \"download_file\": \"تنزيل الملف\",\n        \"drag_drop_text\": \"اسحب الملفات إلى هنا لتحميلها\",\n        \"emoji_error_load\": \"غير قادر على تحميل الرموز التعبرية\",\n        \"error_title\": \"خطأ\",\n        \"failed\": \"فشلت المحاولة \",\n        \"general_upload_error\": \"غير قادر على تحميل الملف \\\"{{ fileName }}\\\"، يرجى إعادة المحاولة.\",\n        \"general_upload_error_label\": \"غير قادر على تحميل الملف\",\n        \"go_to_latest\": \"اذهب إلى الأحدث \",\n        \"hide_button\": \"إخفاء الدردشة\",\n        \"hours_zero\": \"{{ count }} صفر ساعة\",\n        \"hours_one\": \"{{ count }} ساعة\",\n        \"hours_two\": \"{{ count }} ساعتان\",\n        \"hours_few\": \"{{ count }} بضعة ساعات\",\n        \"hours_many\": \"{{ count }} عدة ساعات\",\n        \"hours_other\": \"{{ count }} ساعات أخرى\",\n        \"incoming_call_message\": \"مكالمة واردة من {{ name }}\",\n        \"insert_emoji\": \"إدراج رمز تعبيري\",\n        \"just_now\": \"في هذه اللحظة\",\n        \"limit_2\": \"حجم الملف يجب أن يكون أصغر من 2 ميغابايت، يرجى تحميل ملف أصغر.\",\n        \"limit_50\": \"حجم الملف يجب أن يكون أصغر من 50 ميغابايت، يرجى تحميل ملف أصغر حجماً.\",\n        \"message_not_delivered\": \"لم يتم تسليم الرسالة، انقر هنا لإعادة إرسالها.\",\n        \"message_queued_text_zero\": \"وقت الانتظار حوالي {{ strongStart }} {{ count }} صفر دقیقة {{ strongEnd }}\",\n        \"message_queued_text_one\": \"وقت الانتظار حوالي {{ strongStart }} {{ count }} دقیقة {{ strongEnd }}\",\n        \"message_queued_text_two\": \"وقت الانتظار حوالي {{ strongStart }} {{ count }} دقيقتين {{ strongEnd }}\",\n        \"message_queued_text_few\": \"وقت الانتظار {{ strongStart }} {{ count }} بضعة دقائق {{ strongEnd }}\",\n        \"message_queued_text_many\": \"وقت الانتظار {{ strongStart }} {{ count }} عدة دقائق {{ strongEnd }}\",\n        \"message_queued_text_other\": \"وقت الانتظار حوالي {{ strongStart }} {{ count }} دقائق أخرى {{ strongEnd }}\",\n        \"message_too_long\": \"الرسالة لا يجب أن تتخطى الـ5000 حرف\",\n        \"minutes_zero\": \"{{ count }} صفر دقيقة\",\n        \"minutes_one\": \"{{ count }} دقيقة\",\n        \"minutes_two\": \"{{ count }} دقيقتان\",\n        \"minutes_few\": \"{{ count }} بضعة دقائق\",\n        \"minutes_many\": \"{{ count }} عدة دقائق\",\n        \"minutes_other\": \"{{ count }} دقيقة أخرى\",\n        \"missed_agent\": \"لم يتم الإجابة على مكالمتك\",\n        \"missed_visitor\": \"لقد فاتتك مكالمة\",\n        \"missed_visitor_message_preview\": \"لقد فاتتك مكالمة من\",\n        \"mobile_name\": \"أنت\",\n        \"new_chat\": \"بدء محادثة جديدة\",\n        \"new_conversation\": \"محادثة جديدة\",\n        \"new_message_zero\": \"{{ count }} صفر رسائل جديدة\",\n       