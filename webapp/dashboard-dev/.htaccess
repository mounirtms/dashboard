# This directory is a STALE, NON-CANONICAL copy of the dashboard frontend.
# It exists only as a development scratch tree: canonical source is ../../dashboard/
# and the only deployed bundle is /build/. Nothing here should be web-reachable.
#
# The parent /webapp/.htaccess denies the whole webapp tree, but a nested
# .htaccess cannot be relied on to inherit that: the rules below used to
# re-enable rewrite and `[L]`-serve existing files, which made
# /webapp/dashboard-dev/src/api/client.ts publicly readable (verified HTTP 200
# on 2026-10-03). This file therefore denies outright rather than routing.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
