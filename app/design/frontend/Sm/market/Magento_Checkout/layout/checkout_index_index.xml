<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="footer-container" remove="false"/>

        <!-- Properly disable discount code field while maintaining component structure -->
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="sidebar" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="summary" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <!-- Disable discount component properly -->
                                                <item name="discount" xsi:type="array">
                                                    <item name="component" xsi:type="string">Mab_CheckoutCustomization/js/view/summary/discount-disabled</item>
                                                    <item name="config" xsi:type="array">
                                                        <item name="template" xsi:type="string">Mab_CheckoutCustomization/summary/discount-disabled</item>
                                                    </item>
                                                </item>
                                                <!-- Ensure gift card component remains functional -->
                                                <item name="giftCardAccount" xsi:type="array">
                                                    <item name="config" xsi:type="array">
                                                        <item name="componentDisabled" xsi:type="boolean">false</item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
