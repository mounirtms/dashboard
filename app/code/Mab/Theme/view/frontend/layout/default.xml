<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="logo">
            <arguments>
                <argument name="logo_file" xsi:type="string">images/logo.svg</argument>
                <argument name="logo_width" xsi:type="number">200</argument>
                <argument name="logo_height" xsi:type="number">100</argument>
                <argument name="logo_alt" xsi:type="string">MAB Solutions</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="navigation.sections">
            <block class="Magento\Framework\View\Element\Html\Link\Current" name="about-mab-solutions-link">
                <arguments>
                    <argument name="label" xsi:type="string">About MAB Solutions</argument>
                    <argument name="path" xsi:type="string">about-mab-solutions</argument>
                </arguments>
            </block>
            <block class="Magento\Framework\View\Element\Html\Link\Current" name="mab-services-link">
                <arguments>
                    <argument name="label" xsi:type="string">MAB Services</argument>
                    <argument name="path" xsi:type="string">mab-services</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
