<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    
    <!-- Yalidine Carrier Registration -->
    <type name="Magento\Shipping\Model\Config">
        <arguments>
            <argument name="carriers" xsi:type="array">
                <item name="yalidine" xsi:type="string">Mab\DeliveryOptions\Model\Carrier\Yalidine</item>
            </argument>
        </arguments>
    </type>

    <!-- Plugin to override Mageplaza Table Rate shipping for Yalidin methods -->
    <type name="Mageplaza\TableRateShipping\Model\Carrier\TableRate">
        <plugin name="mab_delivery_yalidine_override" 
                type="Mab\DeliveryOptions\Plugin\Mageplaza\TableRateShipping\Model\Carrier\TableRatePlugin" 
                sortOrder="100"/>
    </type>
    
    <!-- Carrier factory configuration -->
    <virtualType name="MabYalidineCarrierFactory" type="Magento\Shipping\Model\CarrierFactory">
        <arguments>
            <argument name="carriers" xsi:type="array">
                <item name="yalidine" xsi:type="string">Mab\DeliveryOptions\Model\Carrier\Yalidine</item>
            </argument>
        </arguments>
    </virtualType>
</config>