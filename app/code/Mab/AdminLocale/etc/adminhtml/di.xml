<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Force admin locale to English only -->
    <type name="Magento\Framework\Locale\Resolver">
        <plugin name="mab_admin_locale_force_english" type="Mab\AdminLocale\Plugin\LocaleResolver" sortOrder="10"/>
    </type>

    <!-- Override locale config for admin area -->
    <type name="Magento\Framework\Locale\Config">
        <plugin name="mab_admin_locale_config" type="Mab\AdminLocale\Plugin\LocaleConfig" sortOrder="10"/>
    </type>

    <!-- Register console commands -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="mab_admin_remove_french" xsi:type="object">Mab\AdminLocale\Console\Command\RemoveFrenchAdmin</item>
            </argument>
        </arguments>
    </type>
</config>
