<?xml version="1.0"?>
<!--
/**
 * Tawk Widget - Homepage Only Configuration
 * Restricts widget to homepage and fixes positioning
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Remove Tawk from all pages by default -->
        <referenceBlock name="tawk_widget.embed" remove="true"/>
    </body>
</page>
