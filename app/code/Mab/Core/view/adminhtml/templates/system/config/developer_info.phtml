<script type="text/javascript">
require(['jquery'], function($) {
    $(document).ready(function() {
        // Add MAB styling to configuration sections
        $('.section-config').each(function() {
            var $section = $(this);
            var sectionId = $section.attr('id');
            
            if (sectionId && (sectionId.indexOf('mab_') === 0 || sectionId.indexOf('carriers_yalidine') === 0)) {
                $section.addClass('mab-extension-section');
                
                // Add professional badge to MAB sections
                var $heading = $section.find('.config-heading');
                if ($heading.length && !$heading.find('.mab-professional-badge').length) {
                    $heading.append('<span class="mab-professional-badge">Professional</span>');
                }
            }
        });
        
        // Add click tracking for portfolio link
        $('.portfolio-link').on('click', function() {
            if (typeof gtag !== 'undefined') {
                gtag('event', 'click', {
                    'event_category': 'MAB Extensions',
                    'event_label': 'Portfolio Link',
                    'value': 1
                });
            }
        });
        
        // Add hover effects to MAB configuration fields
        $('.mab-extension-section .form-field').hover(
            function() {
                $(this).css('background-color', 'rgba(67, 97, 238, 0.02)');
            },
            function() {
                $(this).css('background-color', '');
            }
        );
    });
});
</script>

<style>
