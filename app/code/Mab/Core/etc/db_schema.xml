<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="mab_core_config" resource="default" engine="innodb" comment="Mab Core Configuration Table">
        <column xsi:type="int" name="config_id" padding="10" unsigned="true" nullable="false" identity="true" 
                comment="Config ID"/>
        <column xsi:type="varchar" name="path" nullable="false" length="255" comment="Config Path"/>
        <column xsi:type="text" name="value" nullable="true" comment="Config Value"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="config_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MAB_CORE_CONFIG_PATH">
            <column name="path"/>
        </constraint>
    </table>
</schema>
