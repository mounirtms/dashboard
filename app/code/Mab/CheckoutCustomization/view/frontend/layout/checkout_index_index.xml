<?xml version="1.0"?>
<!--
/**
 * Minimal Checkout Customization - NO CONFLICTS with Amasty
 * Only adds custom CSS styling, does NOT modify jsLayout
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Add Custom CSS for Professional Styling ONLY -->
        <referenceContainer name="head.additional">
            <block class="Magento\Framework\View\Element\Template" 
                   name="checkout.custom.styles" 
                   template="Mab_CheckoutCustomization::checkout-styles.phtml"/>
        </referenceContainer>
    </body>
</page>
