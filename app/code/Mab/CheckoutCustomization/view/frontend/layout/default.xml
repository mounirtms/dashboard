<?xml version="1.0"?>
<!--
/**
 * Mab CheckoutCustomization
 * OPTIMIZED - No global CSS, loaded per-page only
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <!-- No global CSS - loaded per specific page layout -->
    </head>
    <body>
        <referenceBlock name="checkout_config_provider">
            <arguments>
                <argument name="configProviders" xsi:type="array">
                    <item name="shipping_method_cards" xsi:type="object">Mab\CheckoutCustomization\Model\ShippingMethodConfigProvider</item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
