<?xml version="1.0"?>
<!--
/**
 * Mab CheckoutCustomization
 * OPTIMIZED - No global CSS, loaded per-page only
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <!-- No global CSS - loaded per specific page layout -->
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="shipping.config.injector"
                   template="Mab_CheckoutCustomization::shipping-config.phtml"
                   after="-">
                <arguments>
                    <argument name="viewModel" xsi:type="object">Mab\CheckoutCustomization\Block\ShippingConfig</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
