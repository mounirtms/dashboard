<?php
/**
 * Mab_CheckoutCustomization - Cart Configuration Block
 * Provides window.checkoutConfig for cart page components
 */
/** @var \Mab\CheckoutCustomization\Block\Cart\CheckoutConfig $block */
$escaper = $block->getData('escaper');
if (!$escaper) {
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    $escaper = $objectManager->get(\Magento\Framework\Escaper::class);
}
?>
<script type="text/javascript">
//<![CDATA[
(function() {
    'use strict';
    
    // Initialize minimal checkoutConfig for cart page
    if (typeof window.checkoutConfig === 'undefined') {
        window.checkoutConfig = {
            quoteData: {
                entity_id: '<?= $escaper->escapeJs($block->getQuote()->getId()) ?>',
                store_id: '<?= $escaper->escapeJs($block->getQuote()->getStoreId()) ?>',
                items_count: <?= (int)$block->getQuote()->getItemsCount() ?>,
                items_qty: <?= (int)$block->getQuote()->getItemsQty() ?>,
                grand_total: <?= (float)$block->getQuote()->getGrandTotal() ?>,
                base_grand_total: <?= (float)$block->getQuote()->getBaseGrandTotal() ?>,
                subtotal: <?= (float)$block->getQuote()->getSubtotal() ?>,
                base_subtotal: <?= (float)$block->getQuote()->getBaseSubtotal() ?>
            },
            storeCode: '<?= $escaper->escapeJs($block->getStoreCode()) ?>',
            isCustomerLoggedIn: <?= $block->isCustomerLoggedIn() ? 'true' : 'false' ?>,
            checkoutAgreements: [],
            customerData: {
                email: '<?= $escaper->escapeJs($block->getCustomerEmail()) ?>',
                firstname: '<?= $escaper->escapeJs($block->getCustomerFirstname()) ?>',
                lastname: '<?= $escaper->escapeJs($block->getCustomerLastname()) ?>'
            },
            totalsData: {
                base_currency_code: '<?= $escaper->escapeJs($block->getBaseCurrencyCode()) ?>',
                quote_currency_code: '<?= $escaper->escapeJs($block->getQuoteCurrencyCode()) ?>',
                grand_total: <?= (float)$block->getQuote()->getGrandTotal() ?>,
                base_grand_total: <?= (float)$block->getQuote()->getBaseGrandTotal() ?>,
                subtotal: <?= (float)$block->getQuote()->getSubtotal() ?>,
                base_subtotal: <?= (float)$block->getQuote()->getBaseSubtotal() ?>,
                discount_amount: <?= (float)$block->getQuote()->getShippingAddress()->getDiscountAmount() ?>,
                subtotal_with_discount: <?= (float)$block->getQuote()->getSubtotalWithDiscount() ?>,
                shipping_amount: 0,
                tax_amount: <?= (float)$block->getQuote()->getShippingAddress()->getTaxAmount() ?>,
                items_qty: <?= (int)$block->getQuote()->getItemsQty() ?>,
                total_segments: <?= /* @noEscape */ json_encode($block->getTotalSegments()) ?>
            }
        };
        
        window.isCustomerLoggedIn = window.checkoutConfig.isCustomerLoggedIn;
        window.customerData = window.checkoutConfig.customerData;
        
        console.log('Cart checkoutConfig initialized');
    }
//]]>
</script>

<?php
// Render inline gift card totals row (outside KO, server-side)
$giftCardInfo = $block->getGiftCardInfo();
if ($giftCardInfo && $giftCardInfo['amount_used'] > 0):
?>
<script type="text/javascript">
//<![CDATA[
(function() {
    'use strict';
    // Store gift card info for inline display
    window.mabGiftCardData = <?= /* @noEscape */ json_encode($giftCardInfo) ?>;
//]]>
</script>
<?php endif; ?>
