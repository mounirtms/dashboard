<!-- 
/**
 * Mab_CheckoutCustomization - Ultra Compact Gift Card Block
 * Clean, minimal design with inline layout
 * 
 * @var $block \Magento\Framework\View\Element\Template
 * @var $escaper \Magento\Framework\Escaper
 */
-->
<?php
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
$escaper = $block->getData('escaper');
if (!$escaper) {
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    $escaper = $objectManager->get(Escaper::class);
}

// Check if customer is logged in
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$customerSession = $objectManager->get('Magento\Customer\Model\Session');
$isLoggedIn = $customerSession->isLoggedIn();

// Don't render if not logged in
if (!$isLoggedIn) {
    return '';
}

$blockId = 'block-gift-card-' . uniqid();
?>

<div class="block gift-card compact" id="<?= $escaper->escapeHtmlAttr($blockId) ?>">
    <div class="title" data-role="title">
        <strong id="<?= $escaper->escapeHtmlAttr($blockId) ?>-heading" role="heading" aria-level="2">
            <span class="gift-emoji">🎁</span>
            <?= $escaper->escapeHtml(__('Carte Cadeau')) ?>
        </strong>
    </div>
    
    <div class="content" data-role="content" style="display: none;">
        <form class="form-gift-card compact" id="gift-card-form" method="post" action="/amgcard/cart/apply">
            <div class="fieldset gift-card">
                <!-- Single row: Input + Apply + Check -->
                <div class="gift-card-row">
                    <div class="gift-card-input-wrapper">
                        <input type="text" 
                               class="input-text gift-card-input" 
                               id="gift_card_code" 
                               name="am_giftcard_code" 
                               value="" 
                               placeholder="<?= $escaper->escapeHtmlAttr(__('Code carte cadeau')) ?>"
                               maxlength="50"
                               autocomplete="off"
                               required />
                    </div>
                    <div class="gift-card-actions">
                        <button class="action apply" type="button" id="apply-gift-card-btn">
                            <span><?= $escaper->escapeHtml(__('Appliquer')) ?></span>
                        </button>
                        <button class="action check" type="button" id="check-gift-card-btn">
                            <span><?= $escaper->escapeHtml(__('Solde')) ?></span>
                        </button>
                    </div>
                </div>
                
                <!-- Compact Balance Display -->
                <div class="gift-card-balance" id="gift-card-balance" style="display:none;">
                    <span class="balance-label"><?= $escaper->escapeHtml(__('Solde:')) ?></span>
                    <span class="balance-amount" id="balance-amount">0,00 DZD</span>
                    <span class="balance-status" id="balance-status">(<?= $escaper->escapeHtml(__('Actif')) ?>)</span>
                </div>
                
                <!-- Messages -->
                <div class="messages" id="gift-card-messages" style="display:none;">
                    <div class="message message-error error" id="gift-card-error" style="display:none;">
                        <div id="gift-card-error-text"></div>
                    </div>
                    <div class="message message-success success" id="gift-card-success" style="display:none;">
                        <div id="gift-card-success-text"></div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
