</div>
<script type="text/x-magento-init">
    {
        "*": {
            "Mab_CheckoutCustomization/js/discount-info": {
                "hasCoupon": <?= $hasCouponCode ? 'true' : 'false' ?>,
                "couponCode": "<?= $hasCouponCode ? $block->escapeJs($block->getCouponCode()) : '' ?>"
            }
        }
    }
</script>
<style>
    /* Removed styles for discount-info section */
