                    <label for="coupon_code" class="label">
                        <span><?= $block->escapeHtml(__('Entrez le code de réduction')) ?></span>
                    </label>
                    <div class="control">
                        <input type="text"
                               class="input-text"
                               id="coupon_code"
                               name="coupon_code"
                               value="<?= $block->escapeHtmlAttr($block->getCouponCode()) ?>"
