                        </button>
                    </div>
                    <?php else: ?>
                        <div class="primary">
                            <button  type="button" class="action cancel primary"
                                     value="<?= $block->escapeHtmlAttr(__('Annuler le bon de réduction')) ?>">
                                <span><?= $block->escapeHtml(__('Annuler le bon de réduction')) ?></span>
                            </button>
                        </div>
                    <?php endif; ?>
                </div>
            </div>
        </form>
