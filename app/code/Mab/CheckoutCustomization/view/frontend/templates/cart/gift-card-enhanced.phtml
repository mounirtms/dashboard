<!-- 
/**
 * Mab_CheckoutCustomization - Enhanced Gift Card Block for Cart
 * Modern, user-friendly gift card input with validation and feedback
 */
-->
<div class="cart-gift-card-wrapper" data-bind="scope: 'gift-card-cart'">
    <div class="gift-card-container">
        <div class="gift-card-header">
            <div class="header-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 12v-1.5c0-1-1-1.5-1-1.5s.008-1 0-2.5c-.008-1.5-1.5-2-1.5-2s1.228-5-4.5-5S8 2.5 8 2.5 6.508 3 6.5 4.5C6.492 6 6.5 7 6.5 7S5 7.5 5 9v1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <rect x="2" y="12" width="20" height="10" rx="2" stroke="currentColor" stroke-width="2"/>
                    <path d="M12 12v10" stroke="currentColor" stroke-width="2"/>
                </svg>
            </div>
            <div class="header-text">
                <h3 class="title"><?= $escaper->escapeHtml(__('Carte Cadeau ou Bon d\'Achat')) ?></h3>
                <p class="subtitle"><?= $escaper->escapeHtml(__('Entrez votre code de carte cadeau pour appliquer la réduction')) ?></p>
            </div>
        </div>

        <div class="gift-card-form">
            <div class="form-row">
                <div class="input-wrapper">
                    <input type="text" 
                           id="gift-card-code-input" 
                           name="gift_card_code" 
                           class="gift-card-input" 
                           placeholder="<?= $escaper->escapeHtmlAttr(__('Entrez le code de la carte cadeau')) ?>"
                           maxlength="50"
                           data-bind="
                               value: giftCardCode, 
                               valueUpdate: 'input',
                               attr: { disabled: isApplying }
                           " />
                    <span class="input-icon" data-bind="visible: giftCardCode().length > 0">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14z" stroke="#4caf50" stroke-width="2"/>
                            <path d="M5 8l2 2 4-4" stroke="#4caf50" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </span>
                </div>
                <button type="button" 
                        class="apply-button" 
                        data-bind="
                            click: applyGiftCard,
                            enable: canApply,
                            css: { loading: isApplying }
                        ">
                    <span class="button-text" data-bind="visible: !isApplying()">
                        <?= $escaper->escapeHtml(__('Appliquer')) ?>
                    </span>
                    <span class="button-loader" data-bind="visible: isApplying()">
                        <span class="spinner"></span>
                    </span>
                </button>
            </div>

            <!-- Error Message -->
            <div class="message-wrapper error" data-bind="visible: errorMessage().length > 0">
                <svg class="message-icon" width="16" height="16" viewBox="0 0 16 16">
                    <circle cx="8" cy="8" r="7" fill="#f44336"/>
                    <path d="M8 4v5M8 11v1" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span class="message-text" data-bind="text: errorMessage"></span>
            </div>

            <!-- Success Message -->
            <div class="message-wrapper success" data-bind="visible: successMessage().length > 0">
                <svg class="message-icon" width="16" height="16" viewBox="0 0 16 16">
                    <circle cx="8" cy="8" r="7" fill="#4caf50"/>
                    <path d="M5 8l2 2 4-4" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span class="message-text" data-bind="text: successMessage"></span>
            </div>
        </div>

        <!-- Applied Gift Cards List -->
        <div class="applied-cards-list" data-bind="visible: appliedCards().length > 0">
            <h4 class="list-title"><?= $escaper->escapeHtml(__('Cartes Cadeaux Appliquées')) ?></h4>
            <div data-bind="foreach: appliedCards">
                <div class="applied-card-item">
                    <div class="card-info">
                        <span class="card-code" data-bind="text: code"></span>
                        <span class="card-amount" data-bind="text: amount"></span>
                    </div>
                    <button type="button" 
                            class="remove-button" 
                            data-bind="click: $parent.removeGiftCard">
                        <svg width="16" height="16" viewBox="0 0 16 16">
                            <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <span><?= $escaper->escapeHtml(__('Retirer')) ?></span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Help Text -->
        <div class="gift-card-help">
            <svg class="help-icon" width="16" height="16" viewBox="0 0 16 16">
                <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="2" fill="none"/>
                <path d="M8 6v5M8 4v.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span><?= $escaper->escapeHtml(__('Les cartes cadeaux peuvent être achetées dans nos magasins ou en ligne')) ?></span>
        </div>
    </div>
</div>

<style>
/* Gift Card Container */
.cart-gift-card-wrapper {
    margin: 20px 0;
}

.gift-card-container {
    background: #fff;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

/* Header */
.gift-card-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
}

.gift-card-header .header-icon {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex-shrink: 0;
}

.gift-card-header .title {
    font-size: 18px;
    font-weight: 600;
    color: #333;
    margin: 0 0 4px 0;
}

.gift-card-header .subtitle {
    font-size: 13px;
    color: #666;
    margin: 0;
}

/* Form */
.gift-card-form .form-row {
    display: flex;
    gap: 12px;
    margin-bottom: 12px;
}

.gift-card-form .input-wrapper {
    position: relative;
    flex: 1;
}

.gift-card-form .gift-card-input {
    width: 100%;
    padding: 14px 16px;
    padding-right: 40px;
    font-size: 15px;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    transition: all 0.3s ease;
    font-family: 'Courier New', monospace;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.gift-card-form .gift-card-input:focus {
    outline: none;
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.gift-card-form .gift-card-input:disabled {
    background: #f5f5f5;
    cursor: not-allowed;
}

.gift-card-form .input-icon {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
}

.gift-card-form .apply-button {
    padding: 14px 32px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
    min-width: 120px;
}

.gift-card-form .apply-button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
}

.gift-card-form .apply-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
}

.gift-card-form .apply-button.loading {
    pointer-events: none;
}

.gift-card-form .button-loader {
    display: flex;
    align-items: center;
    justify-content: center;
}

.gift-card-form .spinner {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

/* Messages */
.message-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 14px;
    margin-top: 12px;
    animation: slideDown 0.3s ease;
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.message-wrapper.error {
    background: #ffebee;
    color: #c62828;
    border-left: 4px solid #f44336;
}

.message-wrapper.success {
    background: #e8f5e9;
    color: #2e7d32;
    border-left: 4px solid #4caf50;
}

.message-wrapper .message-icon {
    flex-shrink: 0;
}

/* Applied Cards List */
.applied-cards-list {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid #e0e0e0;
}

.applied-cards-list .list-title {
    font-size: 15px;
    font-weight: 600;
    color: #333;
    margin: 0 0 12px 0;
}

.applied-card-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: #f5f5f5;
    border-radius: 8px;
    margin-bottom: 8px;
}

.applied-card-item .card-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.applied-card-item .card-code {
    font-family: 'Courier New', monospace;
    font-size: 14px;
    font-weight: 600;
    color: #333;
    letter-spacing: 1px;
}

.applied-card-item .card-amount {
    font-size: 13px;
    color: #4caf50;
    font-weight: 600;
}

.applied-card-item .remove-button {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    color: #666;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.applied-card-item .remove-button:hover {
    background: #f44336;
    border-color: #f44336;
    color: #fff;
}

/* Help Text */
.gift-card-help {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 12px;
    background: #f8f9fa;
    border-radius: 8px;
    font-size: 13px;
    color: #666;
}

.gift-card-help .help-icon {
    flex-shrink: 0;
    color: #999;
}

/* Responsive */
@media (max-width: 768px) {
    .gift-card-form .form-row {
        flex-direction: column;
    }
    
    .gift-card-form .apply-button {
        width: 100%;
    }
    
    .applied-card-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }
    
    .applied-card-item .remove-button {
        width: 100%;
        justify-content: center;
    }
}
</style>

<script>
require([
    'jquery',
    'ko',
    'uiComponent',
    'Magento_Customer/js/customer-data'
], function ($, ko, Component, customerData) {
    'use strict';

    ko.components.register('gift-card-cart', {
        viewModel: {
            createViewModel: function (params, componentInfo) {
                return {
                    giftCardCode: ko.observable(''),
                    isApplying: ko.observable(false),
                    errorMessage: ko.observable(''),
                    successMessage: ko.observable(''),
                    appliedCards: ko.observableArray([]),
                    
                    canApply: ko.computed(function () {
                        var code = this.giftCardCode().trim();
                        // Gift card code validation: at least 6 characters, alphanumeric
                        return code.length >= 6 && /^[A-Z0-9-]+$/i.test(code) && !this.isApplying();
                    }, this),
                    
                    applyGiftCard: function () {
                        var self = this;
                        var code = self.giftCardCode().trim();
                        
                        if (!code) {
                            return;
                        }
                        
                        self.isApplying(true);
                        self.errorMessage('');
                        self.successMessage('');
                        
                        // Call Amasty Gift Card API
                        $.ajax({
                            url: '/rest/V1/carts/mine/giftCard',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                giftCardCode: code
                            }),
                            success: function (response) {
                                self.successMessage('Carte cadeau appliquée avec succès!');
                                self.appliedCards.push({
                                    code: code,
                                    amount: response.discount || '0,00 DZD'
                                });
                                self.giftCardCode('');
                                
                                // Clear messages after 5 seconds
                                setTimeout(function() {
                                    self.successMessage('');
                                }, 5000);
                                
                                // Reload cart
                                var sections = ['cart'];
                                customerData.invalidate(sections);
                                customerData.reload(sections, true);
                            },
                            error: function (xhr) {
                                var error = 'Échec de l\'application de la carte cadeau. Veuillez vérifier le code et réessayer.';
                                try {
                                    var response = JSON.parse(xhr.responseText);
                                    if (response.message) {
                                        error = response.message;
                                    }
                                } catch (e) {}
                                self.errorMessage(error);
                                
                                // Clear error after 5 seconds
                                setTimeout(function() {
                                    self.errorMessage('');
                                }, 5000);
                            },
                            complete: function () {
                                self.isApplying(false);
                            }
                        });
                    },
                    
                    removeGiftCard: function (card) {
                        var self = this;
                        self.appliedCards.remove(card);
                        
                        // Call API to remove
                        $.ajax({
                            url: '/rest/V1/carts/mine/giftCard',
                            type: 'DELETE',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                giftCardCode: card.code
                            }),
                            success: function () {
                                self.successMessage('Carte cadeau retirée');
                                
                                // Clear message after 3 seconds
                                setTimeout(function() {
                                    self.successMessage('');
                                }, 3000);
                                
                                // Reload cart
                                var sections = ['cart'];
                                customerData.invalidate(sections);
                                customerData.reload(sections, true);
                            }
                        });
                    }
                };
            }
        },
        template: { element: 'gift-card-cart-template' }
    });
});
</script>
