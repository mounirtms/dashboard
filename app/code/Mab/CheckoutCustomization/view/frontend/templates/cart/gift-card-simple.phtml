<!-- 
/**
 * Mab_CheckoutCustomization - Professional Gift Card Block for Cart
 * Simple, clean interface using Amasty Gift Card Account module
 * 
 * @var $block \Magento\Framework\View\Element\Template
 * @var $escaper \Magento\Framework\Escaper
 */
-->
<?php
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
$escaper = $block->getData('escaper');
if (!$escaper) {
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    $escaper = $objectManager->get(Escaper::class);
}
$blockId = 'block-gift-card-' . uniqid();
?>

<div class="block gift-card" id="<?= $escaper->escapeHtmlAttr($blockId) ?>">
    <div class="title" data-role="title">
        <strong id="<?= $escaper->escapeHtmlAttr($blockId) ?>-heading" role="heading" aria-level="2">
            <?= $escaper->escapeHtml(__('Carte Cadeau')) ?>
        </strong>
    </div>
    
    <div class="content" data-role="content" style="display: none;">
        <form class="form-gift-card" id="gift-card-form">
            <div class="fieldset gift-card">
                <!-- Gift Card Input -->
                <div class="field">
                    <label for="gift_card_code" class="label">
                        <span><?= $escaper->escapeHtml(__('Code de la carte cadeau')) ?></span>
                    </label>
                    <div class="control">
                        <input type="text" 
                               class="input-text" 
                               id="gift_card_code" 
                               name="gift_card_code" 
                               value="" 
                               placeholder="<?= $escaper->escapeHtmlAttr(__('Entrez votre code')) ?>"
                               maxlength="50"
                               autocomplete="off" />
                    </div>
                </div>
                
                <!-- Action Buttons -->
                <div class="actions-toolbar">
                    <div class="primary">
                        <button class="action apply primary" 
                                type="button" 
                                id="apply-gift-card-btn">
                            <span><?= $escaper->escapeHtml(__('Appliquer')) ?></span>
                        </button>
                    </div>
                    <div class="secondary">
                        <button class="action check secondary" 
                                type="button" 
                                id="check-gift-card-btn">
                            <span><?= $escaper->escapeHtml(__('Vérifier')) ?></span>
                        </button>
                    </div>
                </div>
                
                <!-- Balance Display -->
                <div class="gift-card-balance" id="gift-card-balance" style="display:none;">
                    <span class="balance-label"><?= $escaper->escapeHtml(__('Solde:')) ?></span>
                    <span class="balance-amount" id="balance-amount">0,00 DZD</span>
                </div>
                
                <!-- Messages -->
                <div class="messages" id="gift-card-messages" style="display:none;">
                    <div class="message message-error error" id="gift-card-error" style="display:none;">
                        <div id="gift-card-error-text"></div>
                    </div>
                    <div class="message message-success success" id="gift-card-success" style="display:none;">
                        <div id="gift-card-success-text"></div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
/* Simple, Professional Gift Card Styling */
.block.gift-card .title {
    background: #333;
    color: white;
    padding: 12px 16px;
    cursor: pointer;
    border-radius: 4px 4px 0 0;
}

.block.gift-card .content {
    padding: 16px;
    border: 1px solid #ddd;
    border-top: none;
    border-radius: 0 0 4px 4px;
}

.block.gift-card .field {
    margin-bottom: 12px;
}

.block.gift-card .label {
    font-weight: 600;
    color: #333;
    margin-bottom: 6px;
    display: block;
    font-size: 14px;
}

.block.gift-card .input-text {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 14px;
}

.block.gift-card .input-text:focus {
    border-color: #4caf50;
    outline: none;
}

.block.gift-card .actions-toolbar {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
}

.block.gift-card .actions-toolbar .primary,
.block.gift-card .actions-toolbar .secondary {
    flex: 1;
}

.block.gift-card button {
    width: 100%;
    padding: 10px 16px;
    border: none;
    border-radius: 4px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
}

.block.gift-card button.apply {
    background: #4caf50;
    color: white;
}

.block.gift-card button.apply:hover:not(:disabled) {
    background: #43a047;
}

.block.gift-card button.check {
    background: #fff;
    border: 1px solid #ccc;
    color: #333;
}

.block.gift-card button.check:hover:not(:disabled) {
    background: #f5f5f5;
}

.block.gift-card button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.block.gift-card .gift-card-balance {
    background: #f1f8f1;
    border: 1px solid #c8e6c9;
    padding: 10px 12px;
    border-radius: 4px;
    margin-bottom: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.block.gift-card .balance-label {
    font-weight: 600;
    color: #2e7d32;
    font-size: 14px;
}

.block.gift-card .balance-amount {
    font-size: 16px;
    font-weight: 700;
    color: #1b5e20;
}

.block.gift-card .message {
    padding: 10px 12px;
    border-radius: 4px;
    margin-top: 8px;
    font-size: 13px;
}

.block.gift-card .message-error {
    background: #ffebee;
    border: 1px solid #ef5350;
    color: #c62828;
}

.block.gift-card .message-success {
    background: #e8f5e9;
    border: 1px solid #66bb6a;
    color: #2e7d32;
}
</style>

<script>
require([
    'jquery',
    'jquery/ui',
    'mage/collapsible'
], function($) {
    'use strict';
    
    $(document).ready(function() {
        var $block = $('#<?= $escaper->escapeJs($blockId) ?>');
        var $input = $('#gift_card_code');
        var $applyBtn = $('#apply-gift-card-btn');
        var $checkBtn = $('#check-gift-card-btn');
        var $balanceDiv = $('#gift-card-balance');
        var $balanceAmount = $('#balance-amount');
        var $errorMsg = $('#gift-card-error');
        var $errorText = $('#gift-card-error-text');
        var $successMsg = $('#gift-card-success');
        var $successText = $('#gift-card-success-text');
        
        // Initialize collapsible
        $block.collapsible({
            active: false,
            collapsible: true,
            openedState: 'active',
            closedState: '',
            animate: 200
        });
        
        // Validation
        function validateCode(code) {
            code = code.trim();
            if (code.length < 4) {
                return { valid: false, message: '<?= $escaper->escapeJs(__('Le code doit contenir au moins 4 caractères')) ?>' };
            }
            return { valid: true };
        }
        
        // Show message
        function showMessage(type, message, duration) {
            $errorMsg.hide();
            $successMsg.hide();
            
            if (type === 'error') {
                $errorText.text(message);
                $errorMsg.show();
            } else if (type === 'success') {
                $successText.text(message);
                $successMsg.show();
            }
            
            $('#gift-card-messages').show();
            
            if (duration) {
                setTimeout(function() {
                    $errorMsg.hide();
                    $successMsg.hide();
                    $('#gift-card-messages').hide();
                }, duration);
            }
        }
        
        // Check balance
        $checkBtn.on('click', function() {
            var code = $input.val();
            var validation = validateCode(code);
            
            if (!validation.valid) {
                showMessage('error', validation.message, 5000);
                return;
            }
            
            $checkBtn.prop('disabled', true);
            $checkBtn.find('span').text('<?= $escaper->escapeJs(__('Vérification...')) ?>');
            
            $.ajax({
                url: '/amgcard/cart/check',
                type: 'POST',
                dataType: 'json',
                data: { amgiftcard: code },
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function(response) {
                    try {
                        // Response is double-encoded JSON string
                        var data = typeof response === 'string' ? JSON.parse(response) : response;
                        
                        if (data && data.current_value) {
                            $balanceAmount.text(data.current_value);
                            $balanceDiv.show();
                            showMessage('success', '<?= $escaper->escapeJs(__('Carte valide!')) ?>', 5000);
                        } else {
                            showMessage('error', '<?= $escaper->escapeJs(__('Code invalide ou solde épuisé')) ?>', 5000);
                        }
                    } catch (e) {
                        showMessage('error', '<?= $escaper->escapeJs(__('Erreur lors de la vérification')) ?>', 5000);
                    }
                },
                error: function() {
                    showMessage('error', '<?= $escaper->escapeJs(__('Code invalide ou carte expirée')) ?>', 5000);
                },
                complete: function() {
                    $checkBtn.prop('disabled', false);
                    $checkBtn.find('span').text('<?= $escaper->escapeJs(__('Vérifier')) ?>');
                }
            });
        });
        
        // Apply gift card
        $applyBtn.on('click', function() {
            var code = $input.val();
            var validation = validateCode(code);
            
            if (!validation.valid) {
                showMessage('error', validation.message, 5000);
                return;
            }
            
            $applyBtn.prop('disabled', true);
            $applyBtn.find('span').text('<?= $escaper->escapeJs(__('Application...')) ?>');
            
            $.ajax({
                url: '/amgcard/cart/apply',
                type: 'POST',
                data: { 
                    am_giftcard_code: code
                },
                success: function() {
                    showMessage('success', '<?= $escaper->escapeJs(__('Carte appliquée avec succès!')) ?>', 2000);
                    $input.val('');
                    $balanceDiv.hide();
                    
                    setTimeout(function() {
                        location.reload();
                    }, 1500);
                },
                error: function(xhr) {
                    var errorMessage = '<?= $escaper->escapeJs(__('Code invalide ou erreur')) ?>';
                    
                    try {
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        }
                    } catch (e) {}
                    
                    showMessage('error', errorMessage, 5000);
                },
                complete: function() {
                    $applyBtn.prop('disabled', false);
                    $applyBtn.find('span').text('<?= $escaper->escapeJs(__('Appliquer')) ?>');
                }
            });
        });
        
        // Enter key support
        $input.on('keypress', function(e) {
            if (e.which === 13) {
                e.preventDefault();
                $applyBtn.click();
            }
        });
    });
});
</script>
