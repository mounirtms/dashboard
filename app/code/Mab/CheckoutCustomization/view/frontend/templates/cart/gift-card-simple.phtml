<script>
require([
    'jquery',
    'jquery/ui',
    'mage/collapsible'
], function($) {
    'use strict';
    
    $(document).ready(function() {
        var $block = $('#<?= $escaper->escapeJs($blockId) ?>');
        var $form = $('#gift-card-form');
        var $input = $('#gift_card_code');
        var $applyBtn = $('#apply-gift-card-btn');
        var $checkBtn = $('#check-gift-card-btn');
        var $balanceDiv = $('#gift-card-balance');
        var $balanceAmount = $('#balance-amount');
        var $statusValue = $('#status-value');
        var $errorMsg = $('#gift-card-error');
        var $errorText = $('#gift-card-error-text');
        var $successMsg = $('#gift-card-success');
        var $successText = $('#gift-card-success-text');
        
        // Initialize collapsible
        $block.collapsible({
            active: false,
            collapsible: true,
            openedState: 'active',
            closedState: '',
            animate: 200
        });
        
        // Validation
        function validateCode(code) {
            code = code.trim();
            if (code.length < 4) {
                return { 
                    valid: false, 
                    message: '<?= $escaper->escapeJs(__('Le code doit contenir au moins 4 caractères')) ?>' 
                };
            }
            return { valid: true };
        }
        
        // Show message
        function showMessage(type, message, duration) {
            $errorMsg.hide();
            $successMsg.hide();
            
            if (type === 'error') {
                $errorText.text(message);
                $errorMsg.show();
            } else if (type === 'success') {
                $successText.text(message);
                $successMsg.show();
            }
            
            $('#gift-card-messages').show();
            
            if (duration) {
                setTimeout(function() {
                    $errorMsg.hide();
                    $successMsg.hide();
                    $('#gift-card-messages').hide();
                }, duration);
            }
        }
        
        // Check balance
        $checkBtn.on('click', function() {
            var code = $input.val().trim();
            var validation = validateCode(code);
            
            if (!validation.valid) {
                showMessage('error', validation.message, 5000);
                return;
            }
            
            $checkBtn.prop('disabled', true);
            $checkBtn.find('span').text('<?= $escaper->escapeJs(__('Vérification...')) ?>');
            
            $.ajax({
                url: '/amgcard/cart/check',
                type: 'POST',
                dataType: 'json',
                contentType: 'application/json',
                data: JSON.stringify({ giftcard_code: code }),
                success: function(response) {
                    console.log('[Gift Card Check] Response:', response);
                    
                    try {
                        // Handle different response formats
                        var data = response;
                        if (typeof response === 'string') {
                            data = JSON.parse(response);
                        }
                        
                        // Check if we have a valid gift card with balance
                        if (data && (data.current_value || data.balance || data.amount)) {
                            var balance = data.current_value || data.balance || data.amount;
                            $balanceAmount.text(balance);
                            
                            // Set status
                            var status = data.status || 1;
                            if (status == 1 || status === 'active') {
                                $statusValue.text('<?= $escaper->escapeJs(__('Actif')) ?>');
                                $statusValue.css('color', '#2e7d32');
                            } else {
                                $statusValue.text('<?= $escaper->escapeJs(__('Expiré')) ?>');
                                $statusValue.css('color', '#d32f2f');
                            }
                            
                            $balanceDiv.show();
                            showMessage('success', '<?= $escaper->escapeJs(__('Carte cadeau valide et active')) ?>', 5000);
                        } else {
                            $balanceDiv.hide();
                            var errorMsg = data.message || data.error || '<?= $escaper->escapeJs(__('Code invalide ou solde épuisé')) ?>';
                            showMessage('error', errorMsg, 5000);
                        }
                    } catch (e) {
                        console.error('[Gift Card Check] Error parsing response:', e);
                        $balanceDiv.hide();
                        showMessage('error', '<?= $escaper->escapeJs(__('Erreur lors de la vérification du code')) ?>', 5000);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('[Gift Card Check] AJAX Error:', status, error);
                    console.error('[Gift Card Check] Response:', xhr.responseText);
                    
                    var errorMsg = '<?= $escaper->escapeJs(__('Code invalide ou carte expirée')) ?>';
                    
                    try {
                        var response = JSON.parse(xhr.responseText);
                        if (response && response.message) {
                            errorMsg = response.message;
                        }
                    } catch (e) {}
                    
                    $balanceDiv.hide();
                    showMessage('error', errorMsg, 5000);
                },
                complete: function() {
                    $checkBtn.prop('disabled', false);
                    $checkBtn.find('span').text('<?= $escaper->escapeJs(__('Vérifier le solde')) ?>');
                }
            });
        });
        
        // Apply gift card
        $applyBtn.on('click', function() {
            var code = $input.val().trim();
            var validation = validateCode(code);
            
            if (!validation.valid) {
                showMessage('error', validation.message, 5000);
                return;
            }
            
            $applyBtn.prop('disabled', true);
            $applyBtn.find('span').text('<?= $escaper->escapeJs(__('Application en cours...')) ?>');
            
            $.ajax({
                url: '/amgcard/cart/apply',
                type: 'POST',
                dataType: 'json',
                contentType: 'application/json',
                data: JSON.stringify({ giftcard_code: code }),
                success: function(response) {
                    console.log('[Gift Card Apply] Response:', response);
                    
                    try {
                        var data = response;
                        if (typeof response === 'string') {
                            data = JSON.parse(response);
                        }
                        
                        if (data.success || (data.message && !data.error)) {
                            showMessage('success', data.message || '<?= $escaper->escapeJs(__('Carte cadeau appliquée avec succès')) ?>', 3000);
                            
                            // Clear input
                            $input.val('');
                            $balanceDiv.hide();
                            
                            // Reload page to update cart totals after short delay
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            var errorMsg = data.message || data.error || '<?= $escaper->escapeJs(__('Échec de l\'application de la carte cadeau')) ?>';
                            showMessage('error', errorMsg, 5000);
                        }
                    } catch (e) {
                        console.error('[Gift Card Apply] Error parsing response:', e);
                        showMessage('error', '<?= $escaper->escapeJs(__('Erreur lors de l\'application de la carte cadeau')) ?>', 5000);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('[Gift Card Apply] AJAX Error:', status, error);
                    console.error('[Gift Card Apply] Response:', xhr.responseText);
                    
                    var errorMsg = '<?= $escaper->escapeJs(__('Échec de l\'application de la carte cadeau')) ?>';
                    
                    try {
                        var response = JSON.parse(xhr.responseText);
                        if (response && response.message) {
                            errorMsg = response.message;
                        }
                    } catch (e) {}
                    
                    showMessage('error', errorMsg, 5000);
                },
                complete: function() {
                    $applyBtn.prop('disabled', false);
                    $applyBtn.find('span').text('<?= $escaper->escapeJs(__('Appliquer')) ?>');
                }
            });
        });
        
        // Enter key support
        $input.on('keypress', function(e) {
            if (e.which === 13) {
                e.preventDefault();
                $applyBtn.click();
            }
        });
    });
});
</script>
<?php endif; ?>
