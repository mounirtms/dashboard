<script>
require([
    'jquery',
    'jquery/ui',
    'mage/collapsible'
], function($) {
    'use strict';
    
    $(document).ready(function() {
        var $block = $('#<?= $escaper->escapeJs($blockId) ?>');
        var $form = $('#gift-card-form');
        var $input = $('#gift_card_code');
        var $applyBtn = $('#apply-gift-card-btn');
        var $checkBtn = $('#check-gift-card-btn');
        var $balanceDiv = $('#gift-card-balance');
        var $balanceAmount = $('#balance-amount');
        var $statusValue = $('#status-value');
        var $expiryDiv = $('#balance-expiry');
        var $expiryValue = $('#expiry-value');
        var $errorMsg = $('#gift-card-error');
        var $errorText = $('#gift-card-error-text');
        var $successMsg = $('#gift-card-success');
        var $successText = $('#gift-card-success-text');
        
        // Initialize collapsible
        $block.collapsible({
            active: false,
            collapsible: true,
            openedState: 'active',
            closedState: '',
            animate: 200
        });
        
        // Validation
        function validateCode(code) {
            code = code.trim();
            if (code.length < 4) {
                return { 
                    valid: false, 
                    message: '<?= $escaper->escapeJs(__('Le code doit contenir au moins 4 caractères')) ?>' 
                };
            }
            return { valid: true };
        }
        
        // Show message
        function showMessage(type, message, duration) {
            $errorMsg.hide();
            $successMsg.hide();
            
            if (type === 'error') {
                $errorText.text(message);
                $errorMsg.show();
            } else if (type === 'success') {
                $successText.text(message);
                $successMsg.show();
            }
            
            $('#gift-card-messages').show();
            
            if (duration) {
                setTimeout(function() {
                    $errorMsg.hide();
                    $successMsg.hide();
                    $('#gift-card-messages').hide();
                }, duration);
            }
        }
        
        // Check balance
        $checkBtn.on('click', function() {
            var code = $input.val().trim();
            var validation = validateCode(code);
            
            if (!validation.valid) {
                showMessage('error', validation.message, 5000);
                return;
            }
            
            $checkBtn.prop('disabled', true);
            $checkBtn.find('span').text('<?= $escaper->escapeJs(__('Vérification en cours...')) ?>');
            $balanceDiv.hide();
            
            $.ajax({
                url: '/amgcard/cart/check',
                type: 'POST',
                data: { amgiftcard: code },
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function(response) {
                    console.log('[Gift Card Check] Raw Response:', response);
                    console.log('[Gift Card Check] Response type:', typeof response);
                    console.log('[Gift Card Check] Response length:', response ? response.length : 0);
                    
                    try {
                        var data = response;
                        
                        // Handle empty response
                        if (!response || response === '' || response === '""') {
                            console.log('[Gift Card Check] Empty response detected');
                            $balanceDiv.hide();
                            showMessage('error', '<?= $escaper->escapeJs(__('Code invalide ou carte expirée')) ?>', 5000);
                            return;
                        }
                        
                        // Parse if response is a string
                        if (typeof response === 'string') {
                            data = JSON.parse(response);
                        }
                        
                        console.log('[Gift Card Check] Parsed Data:', data);
                        
                        // Check for error response
                        if (data && data.error) {
                            $balanceDiv.hide();
                            showMessage('error', data.message || '<?= $escaper->escapeJs(__('Code invalide')) ?>', 5000);
                            return;
                        }
                        
                        var balanceHtml = data.balance || '';
                        var status = data.status || '';
                        var cardId = data.id;
                        var expiredDate = data.expiredDate || '';
                        var usage = data.usage || '';
                        
                        // Extract plain text balance from HTML
                        var balanceText = balanceHtml;
                        if (balanceHtml.indexOf('<') !== -1) {
                            var tempDiv = document.createElement('div');
                            tempDiv.innerHTML = balanceHtml;
                            balanceText = tempDiv.textContent || tempDiv.innerText || '';
                        }
                        
                        if (cardId) {
                            $balanceAmount.text(balanceText);
                            
                            if (status === 'Actif' || status === 'active' || status === '1' || status == 1) {
                                $statusValue.text('<?= $escaper->escapeJs(__('Actif')) ?>');
                                $statusValue.css('color', '#2e7d32');
                            } else if (status === 'Expiré' || status === 'expired' || status === '0' || status == 0) {
                                $statusValue.text('<?= $escaper->escapeJs(__('Expiré')) ?>');
                                $statusValue.css('color', '#d32f2f');
                            } else {
                                $statusValue.text(status);
                                $statusValue.css('color', '#2e7d32');
                            }
                            
                            // Show expiry date
                            if (expiredDate && expiredDate !== 'unlimited' && expiredDate !== 'null') {
                                var dateObj = new Date(expiredDate);
                                var formattedDate = dateObj.toLocaleDateString('fr-FR', {
                                    day: 'numeric',
                                    month: 'long',
                                    year: 'numeric'
                                });
                                $expiryValue.text(formattedDate);
                                $expiryDiv.show();
                            } else if (expiredDate === 'unlimited' || expiredDate === 'null') {
                                $expiryValue.text('Illimité');
                                $expiryDiv.show();
                            } else {
                                $expiryDiv.hide();
                            }

                            $balanceDiv.show();
                            showMessage('success', '<?= $escaper->escapeJs(__('Carte cadeau valide - Solde: ')) ?>' + balanceText, 5000);
                        } else {
                            $balanceDiv.hide();
                            var errorMsg = data.message || data.error || '<?= $escaper->escapeJs(__('Code invalide ou solde épuisé')) ?>';
                            showMessage('error', errorMsg, 5000);
                        }
                    } catch (e) {
                        console.error('[Gift Card Check] Error:', e);
                        $balanceDiv.hide();
                        showMessage('error', '<?= $escaper->escapeJs(__('Code invalide ou carte expirée')) ?>', 5000);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('[Gift Card Check] AJAX Error:', status, error);
                    console.error('[Gift Card Check] Response:', xhr.responseText);
                    
                    var errorMsg = '<?= $escaper->escapeJs(__('Code invalide ou carte expirée')) ?>';
                    
                    try {
                        var response = JSON.parse(xhr.responseText);
                        if (response && response.message) {
                            errorMsg = response.message;
                        }
                    } catch (e) {}
                    
                    $balanceDiv.hide();
                    showMessage('error', errorMsg, 5000);
                },
                complete: function() {
                    $checkBtn.prop('disabled', false);
                    $checkBtn.find('span').text('<?= $escaper->escapeJs(__('Vérifier le solde')) ?>');
                }
            });
        });
        
        // Apply gift card
        $applyBtn.on('click', function() {
            var code = $input.val().trim();
            var validation = validateCode(code);
            
            if (!validation.valid) {
                showMessage('error', validation.message, 5000);
                return;
            }
            
            $applyBtn.prop('disabled', true);
            $applyBtn.find('span').text('<?= $escaper->escapeJs(__('Application en cours...')) ?>');
            $balanceDiv.hide();
            
            $.ajax({
                url: '/mabgiftcard/giftcard/apply',
                type: 'POST',
                dataType: 'json',
                contentType: 'application/json',
                data: JSON.stringify({ giftcard_code: code }),
                success: function(response) {
                    console.log('[Gift Card Apply] Response:', response);

                    if (response && response.success === true) {
                        var successMsg = response.message || '<?= $escaper->escapeJs(__('Carte cadeau appliquée avec succès')) ?>';
                        showMessage('success', successMsg, 3000);

                        $input.val('');
                        $balanceDiv.hide();

                        // Reload cart totals via AJAX without full page reload
                        $.ajax({
                            url: '/rest/V1/carts/mine',
                            type: 'GET',
                            dataType: 'json',
                            success: function(cartData) {
                                // Update checkoutConfig with new totals
                                if (window.checkoutConfig && window.checkoutConfig.totalsData) {
                                    window.checkoutConfig.totalsData.grand_total = cartData.grand_total;
                                    window.checkoutConfig.totalsData.base_grand_total = cartData.base_grand_total;
                                    window.checkoutConfig.totalsData.subtotal = cartData.subtotal;
                                    window.checkoutConfig.totalsData.base_subtotal = cartData.base_subtotal;

                                    // Reload page to refresh KO totals with updated segments
                                    setTimeout(function() {
                                        location.reload();
                                    }, 800);
                                }
                            },
                            error: function() {
                                // Fallback to reload if cart fetch fails
                                setTimeout(function() {
                                    location.reload();
                                }, 800);
                            }
                        });
                    } else {
                        var errorMsg = response.message || response.error || '<?= $escaper->escapeJs(__('Échec de l\'application de la carte cadeau')) ?>';
                        showMessage('error', errorMsg, 5000);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('[Gift Card Apply] AJAX Error:', status, error);
                    console.error('[Gift Card Apply] Response:', xhr.responseText);

                    var errorMsg = '<?= $escaper->escapeJs(__('Échec de l\'application de la carte cadeau')) ?>';

                    try {
                        var response = JSON.parse(xhr.responseText);
                        if (response && response.message) {
                            errorMsg = response.message;
                        }
                    } catch (e) {}

                    showMessage('error', errorMsg, 5000);
                },
                complete: function() {
                    $applyBtn.prop('disabled', false);
                    $applyBtn.find('span').text('<?= $escaper->escapeJs(__('Appliquer')) ?>');
                }
            });
        });
        
        // Enter key support
        $input.on('keypress', function(e) {
            if (e.which === 13) {
                e.preventDefault();
                $applyBtn.click();
            }
        });
    });
});
</script>
<?php endif; ?>
