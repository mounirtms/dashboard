<?php
/**
 * Customer Login Banner Template for Checkout Page
 * Displays at the VERY TOP of checkout for guest users
 *
 * @var $block \Magento\Framework\View\Element\Template
 */
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$customerSession = $objectManager->get(\Magento\Customer\Model\Session::class);
?>

<?php if (!$customerSession->isLoggedIn()): ?>
<div class="checkout-login-banner-top">
    <div class="login-banner-inner">
        <div class="login-icon">
            <svg width="36" height="36" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="20" cy="20" r="19" stroke="#4CAF50" stroke-width="2"/>
                <circle cx="20" cy="15" r="5" fill="#4CAF50"/>
                <path d="M10 30C10 25 14 22 20 22C26 22 30 25 30 30" stroke="#4CAF50" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </div>
        <div class="login-message">
            <h3><?= $block->escapeHtml(__('Vous êtes déjà client ?')) ?></h3>
            <p><?= $block->escapeHtml(__('Connectez-vous pour retrouver vos cartes cadeaux et vos commandes')) ?></p>
        </div>
        <div class="login-actions">
            <a href="<?= $block->escapeUrl($block->getUrl('customer/account/login', ['referer' => base64_encode($block->getUrl('checkout', ['index' => 'index']))])) ?>"
               class="action primary login-btn">
                <span><?= $block->escapeHtml(__('Se connecter')) ?></span>
            </a>
            <a href="<?= $block->escapeUrl($block->getUrl('customer/account/create')) ?>"
               class="action secondary register-btn">
                <span><?= $block->escapeHtml(__('Créer un compte')) ?></span>
            </a>
        </div>
    </div>
</div>
<?php endif; ?>
