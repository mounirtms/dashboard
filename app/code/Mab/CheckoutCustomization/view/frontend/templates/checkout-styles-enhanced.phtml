<style>
/* =============================================
   PROFESSIONAL MAGENTO CHECKOUT STYLING
   Enhanced Layout - Algeria Wilaya/Region Focus
   No Postcode - Wilaya Only
   Matches Sm/market Theme
   
   IMPORTANT: Magento KO renders field wrapper divs with
   name="shippingAddress.fieldname" (NOT just "fieldname")
   ============================================= */

/* ============ MAIN LAYOUT ============ */
.checkout-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
}

.opc-wrapper {
    background: #fff;
}

/* ============ STEP TITLE ============ */
.opc-wrapper .step-title {
    font-size: 22px;
    font-weight: 700;
    color: #2c2c2c;
    padding-bottom: 15px;
    margin-bottom: 30px;
    border-bottom: 3px solid #007bff;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.opc-wrapper .step-title > strong {
    font-size: 22px;
}

/* ============ FORM FIELD LAYOUT ============ */
.fieldset > .field,
.form-shipping-address .field,
.form-payment .field {
    margin-bottom: 18px;
}

/* Field Labels */
.field .label,
.fieldset > .field > .label {
    font-weight: 600;
    color: #444;
    margin-bottom: 8px;
    display: block;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

.field .label::after {
    content: ':';
    margin-left: 2px;
}

.field.required .label::after,
.field._required .label::after {
    content: ' *';
    color: #dc3545;
}

/* ============ INPUT FIELDS ============ */
.field .control input[type="text"],
.field .control input[type="email"],
.field .control input[type="tel"],
.field .control input[type="number"],
.field .control input[type="password"],
.field .control select,
.field .control textarea {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid #e1e1e1;
    border-radius: 5px;
    font-size: 14px;
    font-family: inherit;
    transition: all 0.3s ease;
    background: #fff;
    color: #333;
    box-sizing: border-box;
}

.field .control input:hover,
.field .control select:hover,
.field .control textarea:hover {
    border-color: #bbb;
}

.field .control input:focus,
.field .control select:focus,
.field .control textarea:focus {
    border-color: #007bff;
    outline: none;
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.12);
}

.field .control input::placeholder,
.field .control textarea::placeholder {
    color: #999;
    font-size: 13px;
}

/* ============ SELECT DROPDOWNS ============ */
.field .control select {
    background: #fff url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="%23666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>') no-repeat right 12px center;
    padding-right: 42px;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    cursor: pointer;
    height: 46px;
}

.field .control select option {
    padding: 10px;
    font-size: 14px;
}

/* Wilaya Select - Special Styling (targets the actual <select> element) */
.field select[name="region_id"],
.wilaya-select {
    background-color: #f0f7ff;
    border-color: #007bff;
    font-weight: 600;
}

.field select[name="region_id"]:focus,
.wilaya-select:focus {
    background-color: #e7f3ff;
    border-color: #0056b3;
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.2);
}

/* ============ FIELD GROUPS ============ */
/* NOTE: Magento KO renders name="shippingAddress.fieldname" on wrapper divs */
/* Responsive two-column layout is handled by Sm/market theme */

.customer-email.fieldset {
    margin-bottom: 25px;
    padding-bottom: 25px;
    border-bottom: 1px solid #e5e5e5;
}

/* ============ HIDE FIELDS GLOBALLY ============ */
/* Use the actual KO-rendered name attribute pattern */
.field[name="shippingAddress.fax"],
.field[name="shippingAddress.company"],
.field[name="shippingAddress.middlename"],
.field[name="shippingAddress.postcode"],
.field[name="billingAddressfree.fax"],
.field[name="billingAddressfree.company"],
.field[name="billingAddressfree.middlename"],
.field[name="billingAddressfree.postcode"],
.field[name="billingAddresscashondelivery.fax"],
.field[name="billingAddresscashondelivery.company"],
.field[name="billingAddresscashondelivery.middlename"],
.field[name="billingAddresscashondelivery.postcode"] {
    display: none !important;
}

/* Also hide region text input (only the dropdown should show) */
.field[name="shippingAddress.region"] {
    display: none !important;
}

/* ============ HIDE COUNTRY FIELD ============ */
/* Algeria-only store: country is always DZ. 
   The KO component must remain for region_id filterBy to work,
   but we hide it visually. */
#shipping-new-address-form .field[name="shippingAddress.country_id"],
.field[name="billingAddressfree.country_id"],
.field[name="billingAddresscashondelivery.country_id"],
.billing-address-form .field[name$=".country_id"] {
    display: none !important;
}

/* ============ CHECKBOXES ============ */
.field.choice,
.field .choice {
    display: flex;
    align-items: center;
    padding: 14px 16px;
    background: #f8f9fa;
    border: 2px solid #e9ecef;
    border-radius: 5px;
    transition: all 0.2s ease;
    cursor: pointer;
    margin-bottom: 10px;
}

.field.choice:hover,
.field .choice:hover {
    background: #e9ecef;
    border-color: #007bff;
}

.field.choice input[type="checkbox"],
.field .choice input[type="radio"] {
    width: 20px;
    height: 20px;
    margin-right: 12px;
    cursor: pointer;
    accent-color: #007bff;
    flex-shrink: 0;
}

.field.choice label,
.field .choice label {
    cursor: pointer;
    font-size: 14px;
    color: #495057;
    font-weight: 500;
    flex: 1;
    margin: 0;
}

/* ============ SHIPPING METHODS ============ */
/* The table header is hidden entirely; the row template
   (shipping-method-item.html) shows: radio+logo | price | method name.
   The Magento core shipping-method-list.html thead is hidden via CSS
   so we don't need to override the core KO template. */
.table-checkout-shipping-method {
    width: 100%;
    border-collapse: collapse;
}

/* Hide the entire thead - no column headers needed */
.table-checkout-shipping-method thead {
    display: none !important;
}

.table-checkout-shipping-method tbody td {
    padding: 14px;
    border: 1px solid #e9ecef;
    vertical-align: middle;
}

.table-checkout-shipping-method .row {
    transition: all 0.2s;
    cursor: pointer;
}

.table-checkout-shipping-method .row:hover {
    background: #f8f9fa;
    border-color: #007bff;
}

.table-checkout-shipping-method .row._selected {
    background: #e7f3ff;
    border-color: #007bff;
}

.table-checkout-shipping-method .col-price {
    font-weight: 700;
    color: #007bff;
    font-size: 15px;
}

/* Hide the carrier title column if it ever appears */
.table-checkout-shipping-method .col-carrier {
    display: none !important;
}

.table-checkout-shipping-method .col-method {
    font-weight: 500;
    color: #333;
}

/* ============ PAYMENT METHODS ============ */
.payment-method {
    background: #fff;
    border: 2px solid #e9ecef;
    border-radius: 5px;
    padding: 16px;
    margin: 12px 0;
    transition: all 0.2s ease;
    cursor: pointer;
}

.payment-method:hover {
    border-color: #007bff;
    background: #f8f9fa;
}

.payment-method._active {
    border-color: #007bff;
    background: #e7f3ff;
    box-shadow: 0 2px 8px rgba(0, 123, 255, 0.1);
}

.payment-method .payment-method-title {
    font-weight: 700;
    color: #2c2c2c;
    font-size: 15px;
    margin: 0;
    display: flex;
    align-items: center;
}

.payment-method .payment-method-title img {
    margin-right: 10px;
    max-height: 30px;
}

.payment-method .payment-method-content {
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid #e9ecef;
}

/* ============ ORDER SUMMARY SIDEBAR ============ */
.opc-block-summary {
    background: #f8f9fa;
    padding: 24px;
    border-radius: 8px;
    border: 1px solid #e9ecef;
}

.opc-block-summary .title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 20px;
    color: #2c2c2c;
    padding-bottom: 15px;
    border-bottom: 3px solid #007bff;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.opc-block-summary .items-in-cart .product-item {
    padding: 15px 0;
    border-bottom: 1px solid #e9ecef;
    display: flex;
    align-items: center;
}

.opc-block-summary .product-item .product-item-name {
    font-weight: 600;
    color: #333;
    font-size: 14px;
    margin: 0 0 5px 0;
}

.opc-block-summary .product-item .product-item-name a {
    color: #333;
}

.opc-block-summary .product-item .product-item-name a:hover {
    color: #007bff;
}

.opc-block-summary .table-totals {
    width: 100%;
    margin: 20px 0;
    border-collapse: collapse;
}

.opc-block-summary .table-totals tr td {
    padding: 10px 0;
    font-size: 14px;
    border-bottom: 1px solid #e9ecef;
}

.opc-block-summary .table-totals .mark {
    font-weight: 500;
    color: #666;
}

.opc-block-summary .table-totals .amount {
    font-weight: 600;
    color: #333;
    text-align: right;
}

.opc-block-summary .table-totals .grand.totals {
    border-top: 2px solid #dee2e6;
    margin-top: 10px;
    padding-top: 15px;
}

.opc-block-summary .table-totals .grand.totals .mark,
.opc-block-summary .table-totals .grand.totals .amount {
    font-size: 18px;
    font-weight: 700;
    color: #2c2c2c;
    border-top: none;
    padding: 15px 0 5px;
}

.opc-block-summary .table-totals .grand.totals .amount {
    color: #007bff;
}

/* ============ PLACE ORDER BUTTON ============ */
.actions-toolbar {
    margin-top: 30px;
}

.actions-toolbar .primary .action.primary.checkout {
    background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    color: #fff;
    border: none;
    padding: 16px 40px;
    font-size: 16px;
    font-weight: 700;
    border-radius: 5px;
    cursor: pointer;
    width: 100%;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
}

.actions-toolbar .primary .action.primary.checkout:hover {
    background: linear-gradient(135deg, #218838 0%, #1aa179 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(40, 167, 69, 0.4);
}

.actions-toolbar .primary .action.primary.checkout:active {
    transform: translateY(0);
    box-shadow: 0 2px 10px rgba(40, 167, 69, 0.3);
}

.actions-toolbar .primary .action.primary.checkout:disabled {
    background: #6c757d;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
}

/* ============ MESSAGES ============ */
.message {
    padding: 14px 18px;
    border-radius: 5px;
    margin: 15px 0;
    font-size: 14px;
    border-left: 4px solid;
}

.message-error {
    background: #f8d7da;
    border-color: #dc3545;
    color: #721c24;
}

.message-success {
    background: #d4edda;
    border-color: #28a745;
    color: #155724;
}

.message-warning {
    background: #fff3cd;
    border-color: #ffc107;
    color: #856404;
}

.message-info {
    background: #d1ecf1;
    border-color: #17a2b8;
    color: #0c5460;
}

/* ============ VALIDATION ============ */
.field._error .control input,
.field._error .control select,
.field._error .control textarea {
    border-color: #dc3545;
    background: #fff5f5;
}

.field-error,
.mage-error {
    color: #dc3545;
    font-size: 12px;
    margin-top: 6px;
    display: block;
    font-weight: 500;
}

.mage-error[generated] {
    display: flex;
    align-items: center;
}

/* ============ LOADING SPINNER ============ */
.loading-mask {
    background: rgba(255, 255, 255, 0.95) !important;
}

/* ============ RESPONSIVE DESIGN ============ */
/* Responsive handling is managed by Sm/market theme via .media-width() mixins */

/* ============ ANIMATIONS ============ */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.opc-wrapper .step-content,
.opc-block-summary,
.payment-method,
.table-checkout-shipping-method .row {
    animation: fadeIn 0.3s ease-out;
}

/* ============ FOCUS & ACCESSIBILITY ============ */
button:focus,
input:focus,
select:focus,
textarea:focus,
.payment-method:focus {
    outline: 2px solid #007bff;
    outline-offset: 2px;
}

/* ============ WILAYA HIGHLIGHT ============ */
.wilaya-highlight {
    background: linear-gradient(135deg, #f0f7ff 0%, #e7f3ff 100%);
    border: 2px solid #007bff;
    border-radius: 5px;
    padding: 15px;
    margin: 15px 0;
}

.wilaya-highlight .label {
    color: #007bff;
    font-weight: 700;
}
</style>

<script>
/**
 * Checkout Field Enhancements - Algeria Focus
 * Uses correct Knockout-rendered name attributes (shippingAddress.X)
 */
require(['jquery', 'domReady!'], function($) {
    'use strict';

    // Add placeholders to inputs (these target the actual <input> name attrs which ARE short)
    $('input[name="firstname"]').attr('placeholder', 'Pr\u00e9nom');
    $('input[name="lastname"]').attr('placeholder', 'Nom');
    $('input[name="telephone"]').attr('placeholder', 'T\u00e9l\u00e9phone');
    $('input[name="city"]').attr('placeholder', 'Commune / Ville');

    // Rename Algeria in country dropdown
    $('select[name="country_id"] option[value="DZ"]').text('Alg\u00e9rie');

    // Hide fields via correct KO name attributes (backup for CSS)
    $('div[name="shippingAddress.fax"]').hide();
    $('div[name="shippingAddress.company"]').hide();
    $('div[name="shippingAddress.middlename"]').hide();
    $('div[name="shippingAddress.postcode"]').hide();
    $('div[name="shippingAddress.region"]').hide();

    // Hide country field - Algeria only store (KO component stays for region filter)
    $('div[name="shippingAddress.country_id"]').hide();
    $('div[name$=".country_id"]').each(function() {
        if ($(this).closest('.billing-address-form').length) {
            $(this).hide();
        }
    });

    // Hide shipping table header row (4-column header)
    $('.table-checkout-shipping-method thead').hide();
});
</script>
