<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="mab_extensions" translate="label" sortOrder="200">
            <label>MAB Extensions</label>
        </tab>
        <section id="mab_checkout" translate="label" type="text" sortOrder="200" showInDefault="1" showInWebsite="1" showInStore="1">
            <label><![CDATA[Checkout Customization]]></label>
            <tab>mab_extensions</tab>
            <resource>Mab_CheckoutCustomization::checkout_config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Settings</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Module</label>
                    <comment>Enable or disable the entire module functionality</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="debug_mode" translate="label comment" type="select" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Debug Mode</label>
                    <comment>Enable debug mode to log checkout errors and warnings</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="display_errors" translate="label comment" type="select" sortOrder="16" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Display Errors</label>
                    <comment>Show detailed error messages in checkout (not recommended for production)</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="debug_mode">1</field>
                    </depends>
                </field>
                <field id="region_options" translate="label" type="textarea" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Region Options</label>
                    <comment>Enter region options in JSON format (e.g., [{&quot;value&quot;: &quot;1&quot;, &quot;label&quot;: &quot;Region 1&quot;}])</comment>
                    <validate>required-entry validate-json</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="min_cart_total" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minimum Cart Total for Free Delivery</label>
                    <comment>Set the minimum cart total required for free delivery</comment>
                    <validate>required-entry validate-number validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="discount_settings" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Discount Code Settings</label>
                <field id="disable_discount_code" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Disable Discount Code Field</label>
                    <comment>Hide the discount code input field in checkout while keeping gift cards functional</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="custom_message" translate="label comment" type="textarea" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom Message</label>
                    <comment>Display a custom message where the discount code field was (optional)</comment>
                    <depends>
                        <field id="disable_discount_code">1</field>
                    </depends>
                </field>
            </group>
            <group id="checkout_steps" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Checkout Steps Configuration</label>
                <field id="enable_shipping_step" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Shipping Step</label>
                    <comment>Show or hide the shipping step in checkout</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="shipping_validation_message" translate="label comment" type="textarea" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Shipping Step Validation Message</label>
                    <comment>Custom message to display when shipping method is required</comment>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="enable_shipping_step">1</field>
                    </depends>
                </field>
                <field id="enable_payment_step" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Payment Step</label>
                    <comment>Show or hide the payment step in checkout</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="payment_validation_message" translate="label comment" type="textarea" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Payment Step Validation Message</label>
                    <comment>Custom message to display when payment method is required</comment>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="enable_payment_step">1</field>
                    </depends>
                </field>
                <field id="enable_review_step" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Review Step</label>
                    <comment>Show or hide the review step in checkout</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="review_validation_message" translate="label comment" type="textarea" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Review Step Validation Message</label>
                    <comment>Custom message to display when order review is required</comment>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="enable_review_step">1</field>
                    </depends>
                </field>
                <field id="allow_guest_checkout" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Allow Guest Checkout</label>
                    <comment>Enable or disable guest checkout functionality</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="amasty_integration" translate="label" type="text" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Amasty Extensions Integration</label>
                <field id="hide_gift_card" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Hide Amasty Gift Card Block</label>
                    <comment>Hide Amasty gift card blocks from checkout while keeping core functionality</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="hide_reward_points" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Hide Amasty Reward Points</label>
                    <comment>Hide Amasty reward points blocks from checkout</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="hide_store_credit" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Hide Amasty Store Credit</label>
                    <comment>Hide Amasty store credit blocks from checkout</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="layout_settings" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Layout Customizations</label>
                <field id="custom_css" translate="label comment" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom CSS</label>
                    <comment>Add custom CSS for checkout page styling</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="display_progress_bar" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Display Progress Bar</label>
                    <comment>Show a progress bar indicating checkout steps</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="responsive_design" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Responsive Design</label>
                    <comment>Optimize checkout for mobile devices</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="error_message_style" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Error Message Style</label>
                    <comment>Choose the style for error messages</comment>
                    <source_model>Mab\CheckoutCustomization\Model\Config\Source\MessageStyle</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="performance" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Performance Settings</label>
                <field id="enable_caching" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Checkout Caching</label>
                    <comment>Cache checkout form data for better performance</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="cache_lifetime" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cache Lifetime (seconds)</label>
                    <comment>How long to keep checkout data in cache</comment>
                    <validate>required-entry validate-digits</validate>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="enable_caching">1</field>
                    </depends>
                </field>
                <field id="minify_checkout_js" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minify Checkout JavaScript</label>
                    <comment>Minify JavaScript files for better performance</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="minify_checkout_css" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minify Checkout CSS</label>
                    <comment>Minify CSS files for better performance</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
