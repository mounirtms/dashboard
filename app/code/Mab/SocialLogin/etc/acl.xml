<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Mab_Core::mab_menu">
                    <resource id="Mab_SocialLogin::social" title="Social Login" translate="title" sortOrder="60">
                        <resource id="Mab_SocialLogin::config" title="Social Login Configuration" translate="title" sortOrder="10"/>
                    </resource>
                </resource>
                
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Mab_SocialLogin::social_config" title="MAB Social Login Settings" translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>