                <value id="onesignal-cdn" type="host">cdn.onesignal.com</value>
                <value id="facebook" type="host">connect.facebook.net</value>
                <value id="clarity" type="host">www.clarity.ms</value>
                <value id="cloudflare" type="host">static.cloudflareinsights.com</value>
                <value id="assets-adobedtm" type="host">assets.adobedtm.com</value>
