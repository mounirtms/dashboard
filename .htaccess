# Parse .html files as PHP
AddHandler application/x-httpd-php .html

# ============================================
# CLOUDFLARE CACHE BYPASS - All dashboard content
# ============================================
# These headers tell Cloudflare to NEVER cache anything from this domain
Header set CF-Cache-Status "DYNAMIC"
Header set CDN-Cache-Control "no-cache, no-store, must-revalidate, private, max-age=0"
Header set Cloudflare-CDN-Cache-Control "no-cache, no-store, must-revalidate, private, max-age=0"
Header set Surrogate-Control "no-store"

# Prevent caching of HTML pages (except /build/ — handled by build/.htaccess)
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} !^/build/
  RewriteRule \.(html|htm)$ - [E=NO_CACHE_HTML:1]
</IfModule>
<FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private" env=NO_CACHE_HTML
    Header set Pragma "no-cache" env=NO_CACHE_HTML
    Header set Expires "0" env=NO_CACHE_HTML
</FilesMatch>

# Prevent caching of API responses
<FilesMatch "\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Prevent caching of CSS and JS for all non-build assets
# /build/assets/ is excluded — its .htaccess sets immutable cache for hashed bundles
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} !^/build/
  RewriteRule \.(css|js)$ - [E=NO_CACHE_JS:1]
</IfModule>
<FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private" env=NO_CACHE_JS
    Header set Pragma "no-cache" env=NO_CACHE_JS
    Header set Expires "0" env=NO_CACHE_JS
</FilesMatch>

# Correct MIME type for service worker (must be application/javascript, not text/html)
<FilesMatch "webpushr-sw\.js$">
    AddType application/javascript .js
    Header always set Service-Worker-Allowed "/"
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# Security headers — use "always" so they appear on all responses including errors
# Child .htaccess (build/) uses "always unset" first to avoid duplicates
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header set X-XSS-Protection "1; mode=block"
Header set Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com https://www.clarity.ms https://scripts.clarity.ms https://connect.facebook.net https://www.googletagmanager.com https://gc.kes.v2.scr.kaspersky-labs.com wss://gc.kes.v2.scr.kaspersky-labs.com https://challenges.cloudflare.com https://cdn.webpushr.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://cloudflareinsights.com https://*.clarity.ms https://www.clarity.ms https://www.google-analytics.com https://analytics.google.com https://*.google.com https://stats.g.doubleclick.net https://*.facebook.com wss://gc.kes.v2.scr.kaspersky-labs.com https://challenges.cloudflare.com https://*.webpushr.com; worker-src 'self' https://cdn.webpushr.com;"

# Flight v2 API routing
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} ^/api/v2/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^api/v2/(.*)$ api/v2/index.php [L,QSA]
</IfModule>

# ============================================
# Skip phpMyAdmin - must come BEFORE SPA routing
# ============================================
<IfModule mod_rewrite.c>
  RewriteRule ^phpmyadmin(/.*)?$ - [L]
</IfModule>

# SPA Routing for React
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Skip phpMyAdmin and other system directories
  RewriteCond %{REQUEST_URI} !^/phpmyadmin
  
  # Skip build assets (JS/CSS bundles)
  RewriteCond %{REQUEST_URI} !^/build/
  
  # Serve webpushr service worker as real file
  RewriteCond %{REQUEST_URI} !^/webpushr-sw\.js$
  
  # Forward Node.js backend requests to proxy
  RewriteRule ^api/(mdm|cegid|techno|magento-node)/(.*)$ api/node-proxy.php [L,QSA]
  
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
# Block .git access
RewriteRule "\.git" - [F,L]
RewriteRule ^\.git - [F,L]

# Block direct access to non-API PHP files (security)
<FilesMatch "\.(phtml|inc)$">
    Require all denied
</FilesMatch>
