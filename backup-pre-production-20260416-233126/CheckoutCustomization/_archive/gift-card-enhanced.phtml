?>

<div class="block gift-card enhanced" id="<?= $escaper->escapeHtmlAttr($blockId) ?>">
    <div class="title" data-role="title">
        <strong id="<?= $escaper->escapeHtmlAttr($blockId) ?>-heading" role="heading" aria-level="2">
            <span class="gift-icon">🎁</span>
            <?= $escaper->escapeHtml(__('Carte Cadeau')) ?>
        </strong>
    </div>
    
    <div class="content" data-role="content" style="display: none;">
        <form class="form-gift-card" id="gift-card-form">
            <div class="fieldset gift-card">
                <!-- Helpful hint -->
                <div class="gift-card-hint">
                    <span class="hint-text">💡 <?= $escaper->escapeHtml(__('Entrez votre code de carte cadeau Techno pour l\'appliquer à votre commande')) ?></span>
                </div>
                
                <!-- Gift Card Input Field -->
                <div class="field">
                    <label for="gift_card_code" class="label">
                        <span><?= $escaper->escapeHtml(__('Code de la carte cadeau')) ?></span>
                    </label>
                    <div class="control">
                        <input type="text" 
                               class="input-text" 
                               id="gift_card_code" 
                               name="gift_card_code" 
                               value="" 
                               placeholder="<?= $escaper->escapeHtmlAttr(__('Ex: GIFT-XXXX-XXXX')) ?>"
                               maxlength="50"
                               autocomplete="off" />
                    </div>
                </div>
                
                <!-- Action Buttons -->
                <div class="actions-toolbar">
                    <div class="primary">
                        <button class="action apply primary gift-card-apply" 
                                type="button" 
                                id="apply-gift-card-btn">
                            <span><?= $escaper->escapeHtml(__('Appliquer')) ?></span>
                        </button>
                    </div>
                    <div class="secondary">
                        <button class="action check secondary" 
                                type="button" 
                                id="check-gift-card-btn">
                            <span><?= $escaper->escapeHtml(__('Vérifier le solde')) ?></span>
                        </button>
                    </div>
                </div>
                
                <!-- Balance Check Result -->
                <div class="gift-card-balance" id="gift-card-balance" style="display:none;">
                    <div class="balance-info">
                        <span class="balance-label"><?= $escaper->escapeHtml(__('Solde disponible:')) ?></span>
                        <span class="balance-amount" id="balance-amount">0,00 DZD</span>
                    </div>
                </div>
                
                <!-- Messages -->
                <div class="messages" id="gift-card-messages" style="display:none;">
                    <div class="message message-error error" id="gift-card-error" style="display:none;">
                        <div id="gift-card-error-text"></div>
                    </div>
                    
                    <div class="message message-success success" id="gift-card-success" style="display:none;">
                        <div id="gift-card-success-text"></div>
                    </div>
                </div>
                
                <!-- Applied Gift Cards -->
                <div class="applied-gift-cards" id="applied-gift-cards" style="display:none;">
                    <div class="applied-title">
                        <strong><?= $escaper->escapeHtml(__('Cartes Appliquées')) ?></strong>
                    </div>
                    <ul class="applied-list" id="applied-cards-list">
                        <!-- Dynamically populated -->
                    </ul>
                </div>
            </div>
        </form>
    </div>
</div>

