<script>
require([
    'jquery',
    'jquery/ui',
    'mage/collapsible',
    'Magento_Customer/js/customer-data'
], function($, ui, collapsible, customerData) {
    'use strict';
    
    $(document).ready(function() {
        var $block = $('#<?= $escaper->escapeJs($blockId) ?>');
        var $input = $('#gift_card_code');
        var $applyBtn = $('#apply-gift-card-btn');
        var $checkBtn = $('#check-gift-card-btn');
        var $balanceDiv = $('#gift-card-balance');
        var $balanceAmount = $('#balance-amount');
        var $errorMsg = $('#gift-card-error');
        var $errorText = $('#gift-card-error-text');
        var $successMsg = $('#gift-card-success');
        var $successText = $('#gift-card-success-text');
        var $appliedCardsContainer = $('#applied-gift-cards');
        var $appliedCardsList = $('#applied-cards-list');
        
        // Initialize collapsible
        $block.collapsible({
            active: false,
            collapsible: true,
            openedState: 'active',
            closedState: '',
            animate: 200
        });
        
        // Validation function
        function validateGiftCardCode(code) {
            code = code.trim();
            if (code.length < 4) {
                return { valid: false, message: '<?= $escaper->escapeJs(__('Le code doit contenir au moins 4 caractères')) ?>' };
            }
            return { valid: true };
        }
        
        // Show message function
        function showMessage(type, message, duration) {
            $errorMsg.hide();
            $successMsg.hide();
            
            if (type === 'error') {
                $errorText.text(message);
                $errorMsg.show();
            } else if (type === 'success') {
                $successText.text(message);
                $successMsg.show();
            }
            
            $('#gift-card-messages').show();
            
            if (duration) {
                setTimeout(function() {
                    $errorMsg.hide();
                    $successMsg.hide();
                    $('#gift-card-messages').hide();
                }, duration);
            }
        }
        
        // Check balance function
        $checkBtn.on('click', function() {
            var code = $input.val();
            var validation = validateGiftCardCode(code);
            
            if (!validation.valid) {
                showMessage('error', validation.message, 5000);
                return;
            }
            
            // Disable button
            $checkBtn.prop('disabled', true).addClass('disabled');
            $checkBtn.find('span').text('<?= $escaper->escapeJs(__('Vérification...')) ?>');
            
            // Make AJAX request to check balance
            $.ajax({
                url: '/amasty_giftcard/account/check',
                type: 'POST',
                data: { code: code },
                success: function(response) {
                    if (response.success && response.balance) {
                        $balanceAmount.text(response.balance + ' DZD');
                        $balanceDiv.show();
                        showMessage('success', '<?= $escaper->escapeJs(__('Carte valide!')) ?>', 5000);
                    } else {
                        showMessage('error', response.message || '<?= $escaper->escapeJs(__('Code invalide ou carte expirée')) ?>', 5000);
                    }
                },
                error: function() {
                    showMessage('error', '<?= $escaper->escapeJs(__('Erreur lors de la vérification')) ?>', 5000);
                },
                complete: function() {
                    $checkBtn.prop('disabled', false).removeClass('disabled');
                    $checkBtn.find('span').text('<?= $escaper->escapeJs(__('Vérifier le solde')) ?>');
                }
            });
        });
        
        // Apply gift card function
        $applyBtn.on('click', function() {
            var code = $input.val();
            var validation = validateGiftCardCode(code);
            
            if (!validation.valid) {
                showMessage('error', validation.message, 5000);
                return;
            }
            
            // Disable button
            $applyBtn.prop('disabled', true).addClass('disabled');
            $applyBtn.find('span').text('<?= $escaper->escapeJs(__('Application...')) ?>');
            
            // Use Amasty Gift Card endpoint
            $.ajax({
                url: '/amasty_giftcard/cart/apply',
                type: 'POST',
                data: { 
                    giftcard_code: code,
                    form_key: $('input[name="form_key"]').val()
                },
                success: function(response) {
                    showMessage('success', '<?= $escaper->escapeJs(__('Carte cadeau appliquée avec succès!')) ?>', 3000);
                    
                    // Clear input
                    $input.val('');
                    $balanceDiv.hide();
                    
                    // Reload page to update cart totals
                    setTimeout(function() {
                        location.reload();
                    }, 1500);
                },
                error: function(xhr) {
                    var errorMessage = '<?= $escaper->escapeJs(__('Échec de l\'application de la carte cadeau.')) ?>';
                    
                    try {
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            var response = JSON.parse(xhr.responseText);
                            if (response.message) {
                                errorMessage = response.message;
                            }
                        }
                    } catch (e) {}
                    
                    showMessage('error', errorMessage, 5000);
                },
                complete: function() {
                    $applyBtn.prop('disabled', false).removeClass('disabled');
                    $applyBtn.find('span').text('<?= $escaper->escapeJs(__('Appliquer')) ?>');
                }
            });
        });
        
        // Enter key support
        $input.on('keypress', function(e) {
            if (e.which === 13) {
                e.preventDefault();
                $applyBtn.click();
            }
        });
    });
});
</script>
